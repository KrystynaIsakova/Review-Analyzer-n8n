        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"topic\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"course_content\",\n        \"difficulty\",\n        \"instructor\",\n        \"assignments\",\n        \"platform\",\n        \"other\"\n      ]\n    },\n    \"problem\": {\n      \"type\": \"string\"\n    },\n    \"severity\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    }\n  },\n  \"required\": [\n    \"topic\",\n    \"problem\",\n    \"severity\"\n  ],\n  \"additionalProperties\": false\n}"
