    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nlet positive = 0;\nlet lowRated = 0;\nlet topics = [];\nlet severities = [];\n\nfor (const row of rows) {\n  if (row.count_review_id !== undefined) {\n    positive = row.count_review_id;\n  }\n\n  if (row.output_topic !== undefined) {\n    topics.push({\n      topic: row.output_topic,\n      count: row.count_output_topic\n    });\n  }\n\n  if (row.output_severity !== undefined) {\n    severities.push({\n      severity: row.output_severity,\n      count: row.count_output_severity\n    });\n\n    lowRated += row.count_output_severity;\n  }\n}\n\ntopics.sort((a, b) => b.count - a.count);\nseverities.sort((a, b) => b.count - a.count);\n\nconst report = `\n# Course Reviews Report\n\n## Overview\n\nTotal reviews: ${positive + lowRated}\nPositive reviews (4–5★): ${positive}\nLow-rated reviews (1–3★): ${lowRated}\n\n## Main Issues\n\n${topics.map(x => `- ${x.topic}: ${x.count}`).join(\"\\n\")}\n\n## Severity\n\n${severities.map(x => `- ${x.severity}: ${x.count}`).join(\"\\n\")}\n`;\n\nreturn [{\n  json: {\n    report\n  }\n}];"
      },
